# Copy this file to `.env` (same directory) and fill in real values.
# `.env` is gitignored -- never commit real credentials.

# Alpaca API keys. Alpaca issues SEPARATE key pairs for paper vs. live
# accounts (enforced server-side -- a paper key cannot authenticate
# against the live endpoint and vice versa), so which account these
# credentials hit is determined by which pair you generate/paste here,
# not just a flag in code. Start with paper-account keys.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# TradeMas credentials for the live NYSE imbalance feed -- same vendor the
# research repo's dashboard uses. If you already have these in the
# research repo's .env, copy them here too (each repo has its own .env).
IMBALANCE_FEED_URL=
TRADEMAS_USERNAME=
TRADEMAS_PASSWORD=
